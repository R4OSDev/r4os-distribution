* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf

*.zig text eol=lf
*.zon text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.R4S text eol=lf
*.R4MF text eol=lf
*.conf text eol=lf
*.sh text eol=lf
*.plan text eol=lf
Tests/Expected/*.plan text eol=crlf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.bin -text
*.CRT -text
*.crt -text
*.ico -text
*.R4D -text
*.R4L -text
*.R4P -text
*.R4X -text
*.WOF -text

# Preserve the frozen system overlays byte-for-byte, including certificates,
# icons, BOMs and historical line endings.
Injection/** -text
TestInjection/** -text
