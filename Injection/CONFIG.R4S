# AUTO permits a native display owner; SOFTWARE keeps firmware graphics.
# Standard release images keep firmware graphics; native GPU packages are optional.
GRAPHICS=SOFTWARE
AUTO=PCI
AUTO=ACPI
SHELL=/R4OS/SOFTWARE/DESKTOP/R4DESK.R4X
DRIVER=DISPBLIT
DRIVER=AMDGPU
OPTION AMDGPU mode=passive
DRIVER=NVIDIA
OPTION NVIDIA mode=auto
DRIVER=HDA
DRIVER=VIRTNET
DRIVER=RTL8139
DRIVER=RTL8168
DRIVER=SID
DRIVER=OPL3
DRIVER=MIDI
OPTION SID model=8580
OPTION NET dhcp=on
LOG=verbose
