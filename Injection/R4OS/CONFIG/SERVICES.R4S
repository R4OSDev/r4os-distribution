# R4OS SERVICES.R4S
# Example registration for real R4X services
SERVICE;name=CLIPSVC;path=C:\R4OS\SERVICES\CLIPSVC.R4X;args=/RUN;start=auto;enabled=yes;description=Clipboard service
SERVICE;name=DNSSVC;path=C:\R4OS\SERVICES\DNSSVC.R4X;args=/RUN;start=auto;enabled=yes;description=DNS resolver service
SERVICE;name=DHCPSVC;path=C:\R4OS\SERVICES\DHCPSVC.R4X;args=/RUN;start=auto;enabled=yes;description=DHCP lease service
SERVICE;name=TIMESVC;path=C:\R4OS\SERVICES\TIMESVC.R4X;args=/RUN;start=auto;enabled=yes;description=Time configuration service
SERVICE;name=LOGSVC;path=C:\R4OS\SERVICES\LOGSVC.R4X;args=/RUN;start=auto;enabled=yes;description=Log aggregation service
SERVICE;name=AUDSVC;path=C:\R4OS\SERVICES\AUDSVC.R4X;args=/RUN;start=auto;enabled=yes;description=Audio and mixer service
SERVICE;name=R4SLSVC;path=C:\R4OS\SERVICES\R4SLSVC.R4X;args=/RUN;start=auto;enabled=yes;description=Serial link service
SERVICE;name=TCPSVC;path=C:\R4OS\SERVICES\TCPSVC.R4X;args=/RUN;start=auto;enabled=yes;description=TCP connection service
SERVICE;name=FTPSVC;path=C:\R4OS\SERVICES\FTPSVC.R4X;args=/RUN;start=auto;enabled=yes;description=FTP server service
SERVICE;name=SSHD;path=C:\R4OS\SERVICES\SSHD.R4X;args=/RUN;start=auto;enabled=yes;description=SSH server service
SERVICE;name=RDPSVC;path=C:\R4OS\SERVICES\RDPSVC.R4X;args=/RUN;start=auto;enabled=yes;description=RDP server service
SERVICE;name=UDPSVC;path=C:\R4OS\SERVICES\UDPSVC.R4X;args=/RUN;start=auto;enabled=yes;description=UDP socket broker service
SERVICE;name=WINSVC;path=C:\R4OS\SERVICES\WINSVC.R4X;args=/RUN;start=auto;enabled=yes;description=Window and task state service
SERVICE;name=UPDSVC;path=C:\R4OS\SERVICES\UPDSVC.R4X;args=/RUN;start=auto;enabled=yes;description=R4OS update service
SERVICE;name=EXSVC;path=C:\R4OS\SERVICES\EXSVC.R4X;args=/RUN;start=manual;enabled=yes;description=Example service
